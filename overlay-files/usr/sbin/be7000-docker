#!/bin/sh
# Set up Docker on this router.
#
# The part that bites people here is where the images go. dockerd defaults its
# data-root to /opt/docker, which lives on the overlay: about 19 MB on this
# board, or 7 MB if the spare partition was left to the stock firmware. One
# image fills it. So this picks a real disk and points dockerd at it.
#
# Usage:
#   be7000-docker status
#   be7000-docker setup [--data-root /mnt/sda1/docker] [--yes]
#   be7000-docker portainer [--yes]

set -e

PKGS="dockerd docker docker-compose luci-app-dockerman"
MIN_FREE_MB=1024

die() { echo "$*" >&2; exit 1; }

# messages follow the LuCI language (luci.main.lang): English for en*, else Russian
EN=0
case "$(uci -q get luci.main.lang)" in en*) EN=1 ;; esac
# t <russian> <english>
t() { [ "$EN" = 1 ] && echo "$2" || echo "$1"; }

data_root_now() {
	uci -q get dockerd.globals.data_root || echo "/opt/docker/"
}

free_mb_of() {
	local path="$1"
	while [ ! -d "$path" ] && [ "$path" != "/" ]; do path="$(dirname "$path")"; done
	df -m "$path" 2>/dev/null | awk 'NR==2 { print $4 }'
}

installed() {
	command -v dockerd >/dev/null 2>&1
}

# A mounted disk that is not the root filesystem and has room.
suggest_data_root() {
	local dev mp free
	mount | while read -r dev _ mp _; do
		case "$dev" in /dev/sd*|/dev/mmcblk*) ;; *) continue ;; esac
		case "$mp" in /|/rom|/overlay|/tmp) continue ;; esac
		free="$(free_mb_of "$mp")"
		[ -n "$free" ] && [ "$free" -ge "$MIN_FREE_MB" ] && { echo "$mp/docker"; return 0; }
	done
	return 1
}

cmd_status() {
	if installed; then
		echo "dockerd: $(t "установлен" "installed"), $(dockerd --version 2>/dev/null | head -1)"
	else
		echo "dockerd: $(t "не установлен" "not installed")"
	fi
	local dr free
	dr="$(data_root_now)"
	free="$(free_mb_of "$dr")"
	echo "$(t "данные" "data"): $dr"
	echo "$(t "свободно там: ${free:-?} МБ" "free there: ${free:-?} MB")"
	if [ -n "$free" ] && [ "$free" -lt "$MIN_FREE_MB" ]; then
		echo
		t "Этого мало. Образы докера считаются сотнями мегабайт." "That is not enough. Docker images take hundreds of megabytes."
		t "Подключите диск и запустите: be7000-docker setup" "Plug in a disk and run: be7000-docker setup"
	fi
	echo
	echo "$(t "служба" "service"): $(/etc/init.d/dockerd status 2>/dev/null || t 'не запущена' 'not running')"
}

cmd_setup() {
	local want="$1" yes="$2" dr free

	if [ -n "$want" ]; then
		dr="$want"
	else
		dr="$(suggest_data_root)" || die "$(t "Не нашёл подключённого диска со свободным местом от ${MIN_FREE_MB} МБ.
Подключите диск, смонтируйте его и укажите путь: be7000-docker setup --data-root /mnt/sda1/docker" "No mounted disk with at least ${MIN_FREE_MB} MB free found.
Plug in a disk, mount it and give the path: be7000-docker setup --data-root /mnt/sda1/docker")"
	fi

	free="$(free_mb_of "$dr")"
	[ -n "$free" ] || die "$(t "Не удалось определить свободное место для $dr" "Could not find out the free space for $dr")"
	if [ "$free" -lt "$MIN_FREE_MB" ]; then
		t "Свободно всего ${free} МБ, это мало для докера." "Only ${free} MB free, that is not enough for Docker." >&2
		[ "$yes" = 1 ] || die "$(t "Если уверены, повторите с --yes" "If you are sure, repeat with --yes")"
	fi

	if [ "$yes" != 1 ]; then
		echo "$(t "Поставлю" "Will install"): $PKGS"
		t "Данные докера будут лежать в: $dr (свободно ${free} МБ)" "Docker data will live in: $dr (${free} MB free)"
		t "Повторите с --yes, чтобы выполнить." "Repeat with --yes to do it."
		exit 1
	fi

	if ! installed; then
		t "Ставлю пакеты" "Installing packages"
		apk update >/dev/null 2>&1 || true
		# shellcheck disable=SC2086
		apk add $PKGS || die "$(t "Не удалось поставить пакеты. Проверьте apk update." "Could not install the packages. Check apk update.")"
	fi

	mkdir -p "$dr"
	t "Прописываю data-root" "Setting data-root"
	uci -q set dockerd.globals.data_root="$dr"
	uci -q commit dockerd

	/etc/init.d/dockerd enable >/dev/null 2>&1 || true
	/etc/init.d/dockerd restart

	echo
	t "Готово. Управление в LuCI: Сервисы, Dockerman." "Done. Manage it in LuCI: Services, Dockerman."
	t "Там контейнеры, образы, сети, тома, логи и консоль внутрь контейнера." "Containers, images, networks, volumes, logs and a console into containers are there."
}

cmd_portainer() {
	local yes="$1"
	installed || die "$(t "Сначала be7000-docker setup" "Run be7000-docker setup first")"
	if [ "$yes" != 1 ]; then
		t "Запущу Portainer CE контейнером, веб-интерфейс на порту 9443 по https." "Will start Portainer CE as a container, web interface on port 9443 over https."
		t "Это отдельный интерфейс поверх докера, со стеками и compose." "It is a separate interface on top of Docker, with stacks and compose."
		t "Повторите с --yes." "Repeat with --yes."
		exit 1
	fi
	docker volume create portainer_data >/dev/null
	docker run -d --name portainer --restart=always \
		-p 9443:9443 \
		-v /var/run/docker.sock:/var/run/docker.sock \
		-v portainer_data:/data \
		portainer/portainer-ce:latest
	t "Portainer поднят. Откройте https://<адрес роутера>:9443 и задайте пароль." "Portainer is up. Open https://<router address>:9443 and set a password."
}

ACTION="$1"
[ $# -gt 0 ] && shift
YES=0; DR=""
while [ $# -gt 0 ]; do
	case "$1" in
	--yes) YES=1 ;;
	--data-root) shift; DR="$1" ;;
	*) ;;
	esac
	shift
done

case "$ACTION" in
status)    cmd_status ;;
setup)     cmd_setup "$DR" "$YES" ;;
portainer) cmd_portainer "$YES" ;;
*)
	echo "usage: be7000-docker {status|setup [--data-root PATH] [--yes]|portainer [--yes]}"
	exit 1
	;;
esac
